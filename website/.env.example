# Wallet Landing Website Environment Variables

# Public URL to the Android APK
# Option A: Direct URL to hosted APK (GitHub Releases, AWS S3, Cloudflare R2, Supabase Storage, etc.)
# VITE_APK_URL=https://github.com/Shreyashpatil2605/wallet-RN/releases/download/v1.0.0/wallet-v1.0.0.apk

# Option B: Relative URL if placing the APK inside website/public/downloads/
# VITE_APK_URL=/downloads/wallet-v1.0.0.apk

# Optional SHA-256 hash for checksum verification
# VITE_APK_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
